# ============================================================
# VM Soccer Sucker 26 — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# ── PUBLIC (safe to expose to browsers, protected by Supabase RLS) ────────

# Found in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Supabase dashboard → Project Settings → API → anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: YouTube playlist ID for background music
# Get it from a YouTube playlist URL: youtube.com/playlist?list=THIS_PART
# Leave blank to use Web Audio crowd noise only.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=

# ── SERVER-SIDE ONLY ──────────────────────────────────────────────────────
# Set these in Vercel → Settings → Environment Variables (NOT in this file
# for production). They must NEVER reach the browser.

# Found in: Supabase dashboard → Project Settings → API → service_role key
# Used by: server actions (admin sign-up), GitHub Actions scripts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Get a free key at: https://www.football-data.org/client/register
# Used by: GitHub Actions sync scripts only (not needed in Vercel)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
