# ============================================================
# VM Soccer Sucker 26 — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — safe for frontend (RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# YouTube playlist ID (safe for frontend)
# Format: the part after ?list= in a YouTube playlist URL
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=your_playlist_id_here

# ============================================================
# The variables below are SERVER-SIDE ONLY.
# Set them in Vercel → Settings → Environment Variables.
# Set them in Supabase → Edge Functions → Secrets.
# NEVER put them in .env.local for production.
# ============================================================

# Supabase service role — edge functions and server actions only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# football-data.org free tier API key — edge functions only
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
